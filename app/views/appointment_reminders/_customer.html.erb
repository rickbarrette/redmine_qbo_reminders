<%# Turning appointment reminders on or off for a customer, on the customer page (redmine_qbo's show_customer_view_right hook) %>
<% customer = local_assigns[:customer] %>
<% if customer && User.current.allowed_to?(:view_customer_appointments, nil, global: true) %>
  <% off = ReminderOptOut.opted_out?(customer) %>
  <div class="customer-reminders">
    <i class="fa-regular fa-envelope"></i>
    <strong><%= l(:label_appointment_reminders) %>:</strong>
    <%= off ? l(:text_customer_reminders_off) : l(:text_customer_reminders_on) %>
    <% if User.current.allowed_to?(:send_appointment_reminders, nil, global: true) %>
      <%= button_to (off ? l(:button_reminders_on) : l(:button_reminders_off)),
                    (off ? customer_reminders_on_path(customer) : customer_reminders_off_path(customer)),
                    method: :post, form_class: 'customer-reminders-toggle' %>
    <% end %>
  </div>
  <style>
    .customer-reminders { margin: 10px 0; }
    form.customer-reminders-toggle { display: inline; margin-left: 8px; }
  </style>
<% end %>
